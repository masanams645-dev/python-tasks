#Q8 — String to Integer (atoi)

def myAtoi(s):
    i = 0
    n = len(s)
    while i < n and s[i].isspace():
        i += 1
    sign = 1
    if i < n and s[i] in '+-':
        if s[i] == '-':
            sign = -1
        i += 1
    result = 0
    while i < n and s[i].isdigit() and s[i].isascii():
        result = result * 10 + int(s[i])
        i += 1
    result *= sign
    result = max(-2**31, min(result, 2**31 - 1))
    return result
s = input("Enter string: ")
print(myAtoi(s))


#Q9:Add Binary
def addBinary(a, b):
    i = len(a) - 1
    j = len(b) - 1
    carry = 0
    result = ""
    while i >= 0 or j >= 0 or carry:
        total = carry
        if i >= 0:
            total += int(a[i])
            i -= 1
        if j >= 0:
            total += int(b[j])
            j -= 1
        result = str(total % 2) + result
        carry = total // 2
    return result
a = input("a = ")
b = input("b = ")
print(addBinary(a, b))


#Q10: Happy Number
def isHappy(n):
    seen = set()
    while n != 1 and n not in seen:
        seen.add(n)
        total = 0
        while n > 0:
            digit = n % 10
            total += digit * digit
            n //= 10
        n = total
    return n == 1
n = int(input("Enter a number: "))
print(isHappy(n))
