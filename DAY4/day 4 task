
# Q1. Number Classification Report

n = int(input())
numbers = list(map(int, input().split()))

positive = negative = zero = 0
even = odd = 0
both = only3 = only5 = neither = 0

for num in numbers:
    if num > 0:
        positive += 1
    elif num < 0:
        negative += 1
    else:
        zero += 1

    if num != 0:
        if num % 2 == 0:
            even += 1
        else:
            odd += 1

    if num % 3 == 0 and num % 5 == 0:
        both += 1
    elif num % 3 == 0:
        only3 += 1
    elif num % 5 == 0:
        only5 += 1
    else:
        neither += 1

print("Positive:", positive)
print("Negative:", negative)
print("Zero:", zero)
print("Even:", even)
print("Odd:", odd)
print("Divisible by both 3 and 5:", both)
print("Divisible only by 3:", only3)
print("Divisible only by 5:", only5)
print("Divisible by neither:", neither)


# Q2. Valid Input Until Accepted

invalid_attempts = 0

while True:
    num = int(input())

    if num < 1 or num > 100:
        print("Invalid input")
        invalid_attempts += 1
        continue

    break

print("Accepted value:", num)
print("Invalid attempts:", invalid_attempts)


# Q3. Menu-Driven Unit Converter

while True:
    print("1. Celsius to Fahrenheit")
    print("2. Kilometres to Miles")
    print("3. Kilograms to Pounds")
    print("4. Exit")

    choice = int(input())

    if choice == 1:
        celsius = float(input())
        fahrenheit = (celsius * 9 / 5) + 32
        print("Celsius to Fahrenheit:", round(fahrenheit, 2))

    elif choice == 2:
        km = float(input())
        miles = km * 0.621371
        print("Kilometres to Miles:", round(miles, 2))

    elif choice == 3:
        kg = float(input())
        pounds = kg * 2.20462
        print("Kilograms to Pounds:", round(pounds, 2))

    elif choice == 4:
        print("Exit")
        break

    else:
        print("Invalid choice")
        continue


# Q4. Multiplication Table with Selective Skipping

n = int(input())
skipped = 0

for i in range(1, 21):
    result = n * i

    if result > 100:
        break

    if result % 3 == 0:
        skipped += 1
        continue

    print(f"{n} x {i} = {result}")

print("Skipped results:", skipped)


# Q5. Password Validation System

password = input()

uppercase = False
lowercase = False
digit = False
special = False

for ch in password:
    if ch.isupper():
        uppercase = True
    elif ch.islower():
        lowercase = True
    elif ch.isdigit():
        digit = True
    else:
        special = True

length_valid = len(password) >= 8

if uppercase:
    print("Uppercase: Present")
else:
    print("Uppercase: Missing")

if lowercase:
    print("Lowercase: Present")
else:
    print("Lowercase: Missing")

if digit:
    print("Digit: Present")
else:
    print("Digit: Missing")

if special:
    print("Special character: Present")
else:
    print("Special character: Missing")

if length_valid:
    print("Minimum length: Satisfied")
else:
    print("Minimum length: Not satisfied")

if uppercase and lowercase and digit and special and length_valid:
    print("Valid password")
else:
    print("Invalid password")


# Q6. Hollow Square Pattern

n = int(input())

for i in range(n):
    for j in range(n):
        if i == 0 or i == n - 1 or j == 0 or j == n - 1:
            print("*", end=" ")
        else:
            print(" ", end=" ")
    print()


# Q7. First Perfect Square in a Range

L, R = map(int, input().split())

found = False

for num in range(max(0, L), R + 1):
    i = 0

    while i * i < num:
        i += 1

    if i * i == num:
        print("First perfect square:", num)
        found = True
        break

if not found:
    print("No perfect square found")


# Q8. Number Guessing Game with Limited Attempts

secret = 8
attempts = 0

while attempts < 5:
    guess = int(input())
    attempts += 1

    if guess == secret:
        print("Correct")
        break
    elif guess < secret:
        print("Too Low")
    else:
        print("Too High")

if attempts == 5 and guess != secret:
    print("Game Over")


# Q9. Longest Consecutive Equal Values

n = int(input())
numbers = list(map(int, input().split()))

current_value = numbers[0]
current_length = 1

best_value = numbers[0]
best_length = 1

for i in range(1, n):
    if numbers[i] == current_value:
        current_length += 1
    else:
        current_value = numbers[i]
        current_length = 1

    if current_length > best_length:
        best_length = current_length
        best_value = current_value

print("Value =", best_value)
print("Length =", best_length)


# Q10. Transaction Validation & Summary

normal = 0
large = 0
suspicious = 0
total = 0

while True:
    amount = int(input())

    if amount == -1:
        break

    if amount == 0:
        pass

    elif amount < 0:
        continue

    elif amount <= 1000:
        normal += 1
        total += amount

    elif amount <= 5000:
        large += 1
        total += amount

    else:
        suspicious += 1
        total += amount

        if suspicious == 3:
            break

print("Normal transactions:", normal)
print("Large transactions:", large)
print("Suspicious transactions:", suspicious)
