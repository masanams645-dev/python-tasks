   "source": [
    "print(\"\\n--- Q4: Bill Calculator ---\")\n",
    "prices = []\n",
    "while True:\n",
    "    value = input(\"Enter item price or 'done': \")\n",
    "    if value.lower() == \"done\":\n",
    "        break\n",
    "    try:\n",
    "        price = float(value)\n",
    "        if price < 0:\n",
    "            print(\"Price cannot be negative.\")\n",
    "            continue\n",
    "        prices.append(price)\n",
    "    except ValueError:\n",
    "        print(\"Enter a valid price.\")\n",
    "\n",
    "print(\"\\n---------- RECEIPT ----------\")\n",
    "print(f\"{'Item':<12}{'Price':>10}\")\n",
    "for i, price in enumerate(prices, start=1):\n",
    "    print(f\"{'Item ' + str(i):<12}{price:>10.2f}\")\n",
    "\n",
    "subtotal = sum(prices)\n",
    "discount = subtotal * 0.10 if subtotal >= 500 else 0\n",
    "tax = (subtotal - discount) * 0.05\n",
    "print(\"-----------------------------\")\n",
    "print(f\"{'Subtotal':<18}{subtotal:>10.2f}\")\n",
    "print(f\"{'Discount':<18}{discount:>10.2f}\")\n",
    "print(f\"{'Tax':<18}{tax:>10.2f}\")\n",
    "print(f\"{'Final Amount':<18}{subtotal - discount + tax:>10.2f}\")\n",
    "\n"
   ]
